# Copier en .env (jamais commité) et renseigner les vraies valeurs en local.
# Les secrets des Edge Functions (colonne "Edge Functions" ci-dessous) se
# configurent via `supabase secrets set` ou le dashboard Supabase, pas ici.
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont auto-injectées par Supabase
# dans chaque Edge Function : inutile de les redéfinir comme secret côté projet.

# --- Frontend (Vite, build-time) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STRIPE_STARTER_MONTHLY=
VITE_STRIPE_PRO_MONTHLY=
VITE_STRIPE_CABINET_MONTHLY=

# --- Fallback SSR générique (process.env) — non utilisé en production
# actuellement, le projet est une SPA statique déployée sur Vercel ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Edge Functions : Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY=
STRIPE_STARTER_YEARLY=
STRIPE_PRO_MONTHLY=
STRIPE_PRO_YEARLY=
STRIPE_CABINET_MONTHLY=
STRIPE_CABINET_YEARLY=

# --- Edge Functions : email transactionnel (Brevo) ---
BREVO_API_KEY=

# --- Edge Functions : IA (ai-chat, wiki-generate-article) ---
ANTHROPIC_API_KEY=

# --- Edge Functions : URL publique utilisée dans les liens envoyés par email ---
SITE_URL=
